# Runtime app image. Distinct from the root CI toolchain Containerfile.
# Packs a prebuilt flashcards binary — no cargo in this file.
#
# ServeDir bakes CARGO_MANIFEST_DIR at compile time. Compile with the
# crate root at /src/crates/web (see publish-image.yml and the README
# local recipe) so static files resolve at /src/crates/web/static.
#
# Build from the repo root after placing the binary at
# deploy/bin/<amd64|arm64>/flashcards. Pass TARGETARCH explicitly
# (plain `docker build` does not set BuildKit platform ARGs):
#   docker build -f deploy/Containerfile --build-arg TARGETARCH=amd64 -t flashcards:local .

FROM debian:bookworm-slim

# TARGETARCH is amd64 / arm64. No default: a default after FROM is a
# BuildKit footgun — arm64 platform builds can still COPY
# deploy/bin/amd64/... (exec format error on arm64 hosts).
# Buildx sets this per --platform; publish also passes --build-arg.
ARG TARGETARCH

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        file \
        libsqlite3-0 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 1000 --create-home --home-dir /home/flashcards flashcards \
    && mkdir -p /data \
    && chown flashcards:flashcards /data

COPY --chmod=755 --chown=flashcards:flashcards deploy/bin/${TARGETARCH}/flashcards /usr/local/bin/flashcards
COPY --chown=flashcards:flashcards crates/web/static /src/crates/web/static
# Pack-time identity (git-sha, optional git-tag) written by publish-image.yml.
# /about reads these at runtime so cargo need not rebuild just to stamp SHA.
COPY --chown=flashcards:flashcards crates/web/pack /src/crates/web/pack

# Fail the pack if the copied binary does not match this platform.
# TARGETARCH is re-stated so a later edit cannot drop it from this RUN.
ARG TARGETARCH
RUN set -eu; \
    info=`file /usr/local/bin/flashcards`; \
    echo "${info}"; \
    case "${TARGETARCH}" in \
      amd64) echo "${info}" | grep -Eq 'x86-64|x86_64' ;; \
      arm64) echo "${info}" | grep -Eq 'ARM aarch64|aarch64' ;; \
      *) echo "unsupported or empty TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac

# Uncompressed per-arch filesystem size (not GHCR compressed download size).
# Measured after COPY so identity files are included; the size file itself is tiny.
RUN mkdir -p /src/crates/web/pack \
    && bytes=`du -sx --block-size=1 / 2>/dev/null | awk '{print $1; exit}'` \
    && if [ -n "$bytes" ] && [ "$bytes" -gt 0 ]; then \
         printf '%s\n' "$bytes" > /src/crates/web/pack/image-size-bytes; \
       fi \
    && chown -R flashcards:flashcards /src/crates/web/pack

# Image defaults: listen on all interfaces; SQLite on a writable volume.
ENV FLASHCARDS_BIND=0.0.0.0:3000
ENV FLASHCARDS_DB=/data/flashcards.db

EXPOSE 3000
VOLUME ["/data"]

USER flashcards
WORKDIR /home/flashcards

CMD ["flashcards"]
